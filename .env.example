# Optional overrides only. A new local installation does not need this file;
# `docker compose up -d --wait` uses the safe loopback defaults below.
# Select the Docker engine with docker context use.
# For Docker Desktop on Linux: docker context use desktop-linux
# Project name also controls the Compose group and named-volume prefix; keep it stable.
COMPOSE_PROJECT_NAME=netstudio
# Existing installations: docs/name-transition.md; do not change database identities.
# NETSTUDIO_EXTERNAL_VOLUMES=true
# NETSTUDIO_POSTGRES_VOLUME=existing-postgres-volume-name
# NETSTUDIO_KEYRING_VOLUME=existing-keyring-volume-name
IMAGE_TAG=local
# Public commit metadata and the isolated Compose updater are enabled by default.
NETSTUDIO_UPDATES_CHECK_ENABLED=1
# Additive catalog v2 is enabled by default. Set to 0 only for response rollback.
NETSTUDIO_DRIVER_CATALOG_V2=1
# Riskli uyumluluk istisnası: varsayılan kapalıdır. Yalnız SNMPv3 sunmayan
# SwOS cihazlarında superadmin cihaz onayı + kaynak ACL/yönetim ağı izolasyonu ile 1 yapın.
NETSTUDIO_ALLOW_SNMP_V2C=0
NETSTUDIO_ENV=development

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
DB_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

POSTGRES_DB=netstudio
POSTGRES_USER=netstudio
POSTGRES_PASSWORD=netstudio
DATABASE_URL=postgresql+psycopg://netstudio:netstudio@postgres:5432/netstudio
NETSTUDIO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional installation-wide ceiling. Empty permits registered device targets.
# Loopback still requires an explicit CIDR; link-local/multicast are rejected.
NETSTUDIO_SSH_ALLOWED_CIDRS=
# Optional additional ceiling for local controller registrations. Empty permits
# an authorized literal-IP controller target; loopback requires an explicit CIDR.
NETSTUDIO_CONTROLLER_ALLOWED_CIDRS=
# Automatic VLAN-aware ARP probe. Development uses the local API binding;
# production must use the installation's HTTPS gateway origin.
# NETSTUDIO_PROBE_API_URL=https://netstudio.example
# NETSTUDIO_PROBE_STATE_VOLUME=netstudio_netstudio-probe-state
# NETSTUDIO_UPDATER_STATE_VOLUME=netstudio_netstudio-updater-state
# For docker-compose.tls.yml: exact HTTPS origin above and certificate directory.
# NETSTUDIO_TLS_DIRECTORY=/absolute/path/to/protected/tls
# TLS_BIND_ADDRESS=127.0.0.1
# TLS_PORT=8443
