# Application settings only; select the Docker engine with docker context use.
# For Docker Desktop on Linux: docker context use desktop-linux
# Project name also controls the Compose group and named-volume prefix; keep it stable.
COMPOSE_PROJECT_NAME=stocc-netstudio
IMAGE_TAG=local
STOCC_ENV=development

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
DB_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

POSTGRES_DB=stocc
POSTGRES_USER=stocc
POSTGRES_PASSWORD=stocc
DATABASE_URL=postgresql+psycopg://stocc:stocc@postgres:5432/stocc
STOCC_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Explicit management subnets only; empty disables all outgoing SSH.
STOCC_SSH_ALLOWED_CIDRS=
# For docker-compose.tls.yml: exact HTTPS origin above and certificate directory.
# STOCC_TLS_DIRECTORY=/absolute/path/to/protected/tls
# TLS_BIND_ADDRESS=127.0.0.1
# TLS_PORT=8443
