#!/usr/bin/env bash
set -euo pipefail

root_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
venv_dir="${root_dir}/.updater-venv"

if [[ "${1:-}" == "setup" ]]; then
  if ! command -v git >/dev/null 2>&1; then
    echo "Git is required to verify the official public checkout." >&2
    exit 1
  fi
  if [[ -n "$(git -C "${root_dir}" status --porcelain --untracked-files=all)" ]]; then
    echo "update_setup_clean_checkout_required" >&2
    exit 1
  fi
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "Python 3.11+ is required for the host updater setup." >&2
  exit 1
fi

python3 -m venv "${venv_dir}"
"${venv_dir}/bin/python" -m pip install --disable-pip-version-check --quiet "${root_dir}/backend"
exec "${venv_dir}/bin/python" -m app.update_setup --installation-dir "${root_dir}" "$@"
